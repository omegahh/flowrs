_flowrs_commands() {
    local commands; commands=(
'run:Execute a pipeline' \
'create:Scaffold a new pipeline in a directory of its own' \
'compile:Validate a pipeline and optionally create a plaintext .flowpkg' \
'registry:Add, remove, and list named pipelines' \
